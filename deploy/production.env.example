# PRODUCTION INTENT TEMPLATE, NOT A READY-TO-DEPLOY RELEASE.
# Do not apply to the existing Render reviewer-demo service.
# Create a separate service and isolated storage only after the launch gates pass.
# Fill secrets in the deployment secret manager, not Git. Empty values fail startup.
ENVIRONMENT=production
CHARGEGUARD_AUTH_MODE=supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Configure asymmetric Supabase signing keys and a 600-second access-token lifetime.
API_KEY=
INTERNAL_API_TOKEN=
RAZORPAY_WEBHOOK_ENABLED=true
RAZORPAY_WEBHOOK_SECRET=
PUBLIC_DEMO_ENABLED=false
CHARGEGUARD_DEMO_SEED=false
RAZORPAY_SIMULATOR_ENABLED=false
CHARGEGUARD_USE_STUBS=false
ALLOW_GLOBAL_PAYMENT_CREDENTIAL_FALLBACK=false
ALLOW_GLOBAL_SEON_CREDENTIAL_FALLBACK=false
# Explicitly opt in only the integrations validated for your authorized merchant.
CHARGEGUARD_LIVE_EVIDENCE_PROVIDERS=
CHARGEGUARD_STORE_BACKEND=postgres
# Use the deployment secret manager. Never put a real connection URL in Git.
DATABASE_URL=
# Transitional credential path; managed-key encryption is still stage 4.
CHARGEGUARD_CREDENTIAL_STORE_PATH=/var/data/production/credentials.json
CHARGEGUARD_CREDENTIAL_ENCRYPTION_KEY=
# No generated/model-training artifacts should be shared with the demo.
MODEL_PATH=/var/data/production/models/approved.pkl
LLM_DECISION_REVIEW_ENABLED=false
REBUTTAL_NARRATIVE_ENABLED=false
PORTFOLIO_ASSISTANT_USE_STUBS=false
CASE_SUMMARY_USE_STUBS=false
# Human approval, durable jobs, private artifacts and provider receipts
# are still prerequisites. Production filing is intentionally blocked in code.
