# ChargeGuard environment template.
# Copy this file to .env for local Docker Compose runs and fill in real secrets there.
# Never commit real API keys, webhook secrets, OAuth tokens, or customer data.
# This template lists all supported settings; a local .env may omit optional entries.
# Secret values and live/stub choices in .env are expected to differ from this file.

# Runtime
ENVIRONMENT=development
PORT=8000
CHARGEGUARD_API_URL=http://127.0.0.1:8000

# Required for every API endpoint except /health. Multiple keys may be comma-separated.
API_KEY=

# Optional internal-only raw-state debugging token for include_raw=true dispute responses.
INTERNAL_API_TOKEN=

# Per-key request limits.
WEBHOOK_RATE_LIMIT_PER_MINUTE=30
ASSISTANT_RATE_LIMIT_PER_MINUTE=10

# Development default: use deterministic evidence instead of external provider APIs.
CHARGEGUARD_USE_STUBS=true

# Per-provider live/stub overrides. Unset = follows CHARGEGUARD_USE_STUBS.
# For India-first live testing, keep all providers stubbed except Razorpay.
RAZORPAY_USE_STUBS=
STRIPE_USE_STUBS=
SHIPROCKET_USE_STUBS=
DELHIVERY_USE_STUBS=
SEON_USE_STUBS=
ETHOCA_USE_STUBS=
VERIFI_USE_STUBS=
GMAIL_USE_STUBS=
FRESHDESK_USE_STUBS=
CLAUDE_VISION_USE_STUBS=
CASE_SUMMARY_USE_STUBS=
REASON_CLASSIFICATION_USE_STUBS=
REBUTTAL_NARRATIVE_USE_STUBS=
PORTFOLIO_ASSISTANT_USE_STUBS=

# Razorpay Test Mode REST credentials for outbound payment/dispute enrichment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Storefront credentials are merchant-level settings captured through authenticated
# merchant onboarding, not global environment variables. Each merchant may provide
# storefront_platform plus Shopify Admin token or WooCommerce key/secret credentials.
# ChargeGuard verifies them synchronously and never returns credential values in API responses.
# The local JSON store intentionally does not persist credential values; production deployments
# should reconnect them from a managed secret store after restart.

# Incoming Razorpay dispute webhooks use this separate HMAC secret.
# This is different from RAZORPAY_KEY_SECRET.
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_ENABLED=true
RAZORPAY_WEBHOOK_MAX_BODY_BYTES=1048576
PROVIDER_EVENT_CLAIM_TIMEOUT_SECONDS=300
RAZORPAY_RECOVER_PENDING_ON_STARTUP=true
RAZORPAY_STARTUP_RECOVERY_LIMIT=25

# Local-only Razorpay dispute simulator. Never enable in production.
RAZORPAY_SIMULATOR_ENABLED=false
RAZORPAY_SIMULATOR_TARGET_URL=http://127.0.0.1:8000/webhook/razorpay

# Local persistence and generated files.
# For Docker staging, use /var/data/chargeguard_store.json with the compose volume.
CHARGEGUARD_STORE_PATH=
REBUTTAL_OUTPUT_DIR=./output/rebuttals

# ML artifacts and feedback loop.
MODEL_PATH=./ml/artifacts/win_probability_model.pkl
TRAINING_DATA_PATH=./ml/artifacts/outcomes.json
TRAINING_METADATA_PATH=./ml/artifacts/training_metadata.json
PLAYBOOK_STATS_PATH=./ml/artifacts/playbook_stats.json
RETRAIN_RECORD_THRESHOLD=10
SYNTHETIC_SEED_COUNT=200
SYNTHETIC_DECAY_PER_REAL_RECORD=4

# Decision economics.
# FX rates are currency units per USD and are used for normalized amount bucketing.
RESPONSE_COST_USD=15.0
RESPONSE_COST_INR=1200.0
RESPONSE_COST_DEFAULT=15.0
RESPONSE_COST_FX_RATES=INR:83.0,USD:1.0
FIGHT_EV_THRESHOLD=0.0

# Stripe sandbox, used for secondary/international payment evidence.
STRIPE_API_KEY=

# India logistics evidence.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
DELHIVERY_API_TOKEN=

# Support evidence. Credentials stay in env vars, not merchant API payloads.
FRESHDESK_API_KEY=
FRESHDESK_DOMAIN=
GMAIL_ACCESS_TOKEN=
GMAIL_USER_ID=me

# Optional merchant-scoped support connector example.
# Set support_connector_ref=ACME on a merchant to use these instead of globals.
CHARGEGUARD_CONNECTOR_ACME_FRESHDESK_API_KEY=
CHARGEGUARD_CONNECTOR_ACME_FRESHDESK_DOMAIN=
CHARGEGUARD_CONNECTOR_ACME_GMAIL_ACCESS_TOKEN=
CHARGEGUARD_CONNECTOR_ACME_GMAIL_USER_ID=support@acme.example

# Device and consortium evidence.
SEON_API_KEY=
DEVICE_GEO_MATCH_KM=100
ETHOCA_API_KEY=
ETHOCA_BASE_URL=
VERIFI_API_KEY=
VERIFI_BASE_URL=

# Food/QCom platform evidence.
FOOD_PLATFORM_API_KEY=
FOOD_PLATFORM_BASE_URL=

# Optional LLM integrations. Leave stubbed unless configured.
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=claude-3-5-sonnet-latest
CASE_SUMMARY_MODEL=claude-sonnet-5
# Optional, on-demand Razorpay reason-code recommendation. Disabled by default.
# Recommendations never update classification or start agents without operator approval.
REASON_CLASSIFICATION_ENABLED=false
REASON_CLASSIFICATION_MODEL=claude-sonnet-5
REASON_CLASSIFICATION_MIN_CONFIDENCE=0.85
REASON_CLASSIFICATION_TIMEOUT_SECONDS=20
REBUTTAL_NARRATIVE_ENABLED=false
REBUTTAL_NARRATIVE_MODEL=claude-sonnet-5
PORTFOLIO_ASSISTANT_MODEL=claude-sonnet-5

# Approved network monitoring thresholds. Blank means unconfigured.
VISA_DISPUTE_RATIO_THRESHOLD_PCT=
MASTERCARD_DISPUTE_RATIO_THRESHOLD_PCT=
RUPAY_DISPUTE_RATIO_THRESHOLD_PCT=
AMEX_DISPUTE_RATIO_THRESHOLD_PCT=
