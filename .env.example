# Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Required for every API endpoint except /health. Multiple keys may be comma-separated.
API_KEY=replace-with-a-strong-api-key

# Maximum webhook requests per API key each minute.
WEBHOOK_RATE_LIMIT_PER_MINUTE=30

# TODO: Set approved network monitoring thresholds; blank means UNCONFIGURED.
VISA_DISPUTE_RATIO_THRESHOLD_PCT=
MASTERCARD_DISPUTE_RATIO_THRESHOLD_PCT=
RUPAY_DISPUTE_RATIO_THRESHOLD_PCT=
AMEX_DISPUTE_RATIO_THRESHOLD_PCT=

# LangSmith
LANGSMITH_API_KEY=...
LANGSMITH_PROJECT=chargeguard-ai

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=...

# Razorpay (sandbox)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...

# Development only: use deterministic evidence instead of external APIs
CHARGEGUARD_USE_STUBS=true

# Per-provider live/stub overrides. Unset = falls back to CHARGEGUARD_USE_STUBS.
# Set one to false to test that provider live while all others remain stubbed.
RAZORPAY_USE_STUBS=
STRIPE_USE_STUBS=
SHIPROCKET_USE_STUBS=
DELHIVERY_USE_STUBS=
SEON_USE_STUBS=
ETHOCA_USE_STUBS=
VERIFI_USE_STUBS=
GMAIL_USE_STUBS=
FRESHDESK_USE_STUBS=
CLAUDE_VISION_USE_STUBS=

# Optional local API persistence. Leave empty for in-memory only.
CHARGEGUARD_STORE_PATH=./data/chargeguard_store.json

# Stripe (sandbox)
STRIPE_API_KEY=sk_test_...

# Shiprocket (sandbox)
SHIPROCKET_EMAIL=...
SHIPROCKET_PASSWORD=...

# Delhivery fallback
DELHIVERY_API_TOKEN=...

# Freshdesk
FRESHDESK_API_KEY=...
FRESHDESK_DOMAIN=yourmerchant.freshdesk.com

# Gmail API (read-only OAuth token)
GMAIL_ACCESS_TOKEN=...
GMAIL_USER_ID=me

# SEON
SEON_API_KEY=...
DEVICE_GEO_MATCH_KM=100

# Consortium alert APIs (merchant-specific enterprise endpoints)
ETHOCA_API_KEY=...
ETHOCA_BASE_URL=https://your-ethoca-endpoint.example
VERIFI_API_KEY=...
VERIFI_BASE_URL=https://your-verifi-endpoint.example

# Food/QCom platform evidence
FOOD_PLATFORM_API_KEY=...
FOOD_PLATFORM_BASE_URL=https://your-food-platform-endpoint.example
ANTHROPIC_VISION_MODEL=claude-3-5-sonnet-latest

# Filing output
REBUTTAL_OUTPUT_DIR=./output/rebuttals

# ML
MODEL_PATH=./ml/artifacts/win_probability_model.pkl
RESPONSE_COST_USD=15.0
RESPONSE_COST_INR=1200.0
FIGHT_EV_THRESHOLD=0.0

# Learning
TRAINING_DATA_PATH=./ml/artifacts/outcomes.json
TRAINING_METADATA_PATH=./ml/artifacts/training_metadata.json
PLAYBOOK_STATS_PATH=./ml/artifacts/playbook_stats.json
RETRAIN_RECORD_THRESHOLD=10
